# ================================================================
# CEAR AIT Website - Cloud Database & Storage (Supabase)
# ================================================================
# Free forever on Supabase.com hobby tier.
# Add your keys here in .env.local to persist live updates and image uploads.

# 1. Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key (safe to use in client requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Optional Service Role Key (for unrestricted server-side syncing)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
